---
export const prerender = false;

import { marked } from "marked";
import "../../styles/global.css";

const { slug } = Astro.params;
const apiBase = import.meta.env.API_INTERNAL_URL || "http://localhost:8000";

let post: any = null;
let notFound = false;

try {
  const res = await fetch(`${apiBase}/api/posts/${slug}?locale=en`);
  if (res.status === 404) {
    notFound = true;
  } else if (res.ok) {
    post = await res.json();
  }
} catch {
  notFound = true;
}

if (notFound) return Astro.redirect("/blog", 302);

const contentHtml = post?.content ? marked(post.content) : "";
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} — Ramin Shirani</title>
    <meta name="description" content={post.excerpt} />
  </head>
  <body>
    <div class="post-page">
      <header class="post-header">
        <a href="/blog" class="back-link">← Blog</a>
        <h1>{post.title}</h1>
        <div class="post-meta">
          <time datetime={post.created_at}>
            {new Date(post.created_at).toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })}
          </time>
          {post.tags.length > 0 && (
            <span class="tags">
              {post.tags.map((tag: string) => <span class="tag">{tag}</span>)}
            </span>
          )}
        </div>
        {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
      </header>
      <article class="post-content" set:html={contentHtml} />
    </div>
    <style>
      .post-page { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem; }
      .post-header { margin-bottom: 2.5rem; border-bottom: 1px solid var(--border, #e0e0e0); padding-bottom: 1.5rem; }
      .back-link { color: var(--accent); font-weight: 500; display: inline-block; margin-bottom: 1rem; }
      h1 { margin: 0 0 0.75rem; font-size: 2rem; line-height: 1.25; }
      .post-meta { display: flex; align-items: center; gap: 1rem; color: var(--text-muted, #888); font-size: 0.9rem; }
      .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
      .tag { background: var(--tag-bg, #f0f0f0); padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.8rem; }
      .post-excerpt { margin: 1rem 0 0; font-size: 1.1rem; color: var(--text-muted, #666); font-style: italic; }
      .post-content { line-height: 1.8; }
      .post-content h2, .post-content h3 { margin-top: 2rem; }
      .post-content pre { background: var(--code-bg, #f5f5f5); padding: 1rem; border-radius: 8px; overflow-x: auto; }
      .post-content code { font-size: 0.9em; }
      .post-content img { max-width: 100%; border-radius: 8px; }
    </style>
  </body>
</html>
