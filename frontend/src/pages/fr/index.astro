---
export const prerender = false;

import CVLayout from "../../layouts/CVLayout.astro";
import fallback from "../../data/cv_data.fr.json";

const apiBase = import.meta.env.API_INTERNAL_URL || "http://localhost:8000";
let cvData: typeof fallback = fallback;
try {
  const res = await fetch(`${apiBase}/api/cv/fr`);
  if (res.ok) cvData = await res.json();
} catch {
  // backend unavailable — use bundled seed data
}
---
<CVLayout locale="fr" cvData={cvData} />
