# ── GitHub (for the repos section) ──────────────────────────────────────────
GITHUB_USERNAME=yourusername
GITHUB_TOKEN=

# ── OpenAI (CV parsing + blog translation) ───────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Admin credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# Recommended for production — bcrypt hash of your password.
# Generate with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Dev-only plain password (ignored if ADMIN_PASSWORD_HASH is set)
# ADMIN_PASSWORD=changeme

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Set to false only for local HTTP dev (cookies won't be Secure over plain HTTP)
COOKIE_SECURE=true

# ── Agent API key (X-API-Key header) ─────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key

# ── Data paths (inside container — keep defaults unless you change the volume) ─
CV_DATA_DIR=/data/cv
DB_PATH=/data/blog/portfolio.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API
CORS_ORIGINS=https://yourdomain.com
